---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import profilePic from "../assets/hero-photo-pixel.png";
---

<Layout>
  <!-- Hero -->
  <section class="relative pt-6 sm:pt-10 pb-4">
    <div class="hero-glow"></div>
    <Image
      src={profilePic}
      alt="Marcelo Aguirre"
      width="96"
      height="96"
      format="png"
      fetchpriority="high"
      class="pixel-img pixel-frame object-cover w-16 h-16 sm:w-20 sm:h-20 mb-5 relative"
    />
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-1">Marcelo Aguirre</h1>
    <p class="text-[var(--fg-muted)] text-sm sm:text-base leading-relaxed break-words font-medium">
      <span x-show="language === 'es'">Fullstack &amp; AI Engineer · TypeScript Specialist · LLM Systems &amp; Web3</span>
      <span x-show="language === 'en'">Fullstack &amp; AI Engineer · TypeScript Specialist · LLM Systems &amp; Web3</span>
    </p>

    <!-- Socials -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-4">
      <a href="https://www.linkedin.com/in/xhelodev" target="_blank" rel="noopener" aria-label="LinkedIn" class="inline-flex items-center justify-center min-h-11 min-w-11 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/xhelodev" target="_blank" rel="noopener" aria-label="GitHub" class="inline-flex items-center justify-center min-h-11 min-w-11 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href="https://x.com/xhelodev" target="_blank" rel="noopener" aria-label="X" class="inline-flex items-center justify-center min-h-11 min-w-11 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://t.me/xhelodev" target="_blank" rel="noopener" aria-label="Telegram" class="inline-flex items-center justify-center min-h-11 min-w-11 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
      <a href="mailto:contact@xhelo.dev" aria-label="Email" class="inline-flex items-center justify-center min-h-11 min-w-11 text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="0"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
    </div>
  </section>

  <hr class="divider" />

  <!-- Sobre mí -->
  <section>
    <h2 class="text-xl font-semibold mb-4">
      <span x-show="language === 'es'">Sobre mí</span>
      <span x-show="language === 'en'">About me</span>
    </h2>
    <p class="leading-relaxed text-[var(--fg-muted)]">
      <span x-show="language === 'es'">
        Desarrollador fullstack especializado en arquitecturas robustas de extremo a extremo,
        con foco en <strong class="text-[var(--fg)]">rendimiento</strong>,
        <strong class="text-[var(--fg)]">escalabilidad</strong> y
        <strong class="text-[var(--fg)]">experiencia de usuario</strong>. Apasionado por la
        <strong class="text-[var(--fg)]">Inteligencia Artificial</strong> — agentes autónomos,
        pipelines RAG y sistemas LLM en producción — y por el ecosistema
        <strong class="text-[var(--fg)]">Web3, blockchain y DeFi</strong>. Con sólida base en
        <strong class="text-[var(--fg)]">TypeScript</strong>,
        <strong class="text-[var(--fg)]">Python</strong> e
        <strong class="text-[var(--fg)]">infraestructura Linux</strong>, construyo soluciones
        que combinan fiabilidad técnica con innovación.
      </span>
      <span x-show="language === 'en'">
        Fullstack developer specialized in robust end-to-end architectures, with a focus on
        <strong class="text-[var(--fg)]">performance</strong>,
        <strong class="text-[var(--fg)]">scalability</strong> and
        <strong class="text-[var(--fg)]">user experience</strong>. Passionate about
        <strong class="text-[var(--fg)]">Artificial Intelligence</strong> — autonomous agents,
        RAG pipelines and LLM systems in production — and the
        <strong class="text-[var(--fg)]">Web3, blockchain and DeFi</strong> ecosystem.
        With a solid base in
        <strong class="text-[var(--fg)]">TypeScript</strong>,
        <strong class="text-[var(--fg)]">Python</strong> and
        <strong class="text-[var(--fg)]">Linux infrastructure</strong>, I build solutions that
        combine technical reliability with innovation.
      </span>
    </p>
  </section>

  <hr class="divider" />

  <!-- Tech Stack -->
  <section>
    <h2 class="text-xl font-semibold mb-4">
      <span x-show="language === 'es'">Tech Stack</span>
      <span x-show="language === 'en'">Tech Stack</span>
    </h2>
    <div class="flex flex-col gap-4">
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">AI &amp; LLMs</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-ai">PyTorch</span>
          <span class="badge badge-ai">LangGraph</span>
          <span class="badge badge-ai">RAG</span>
          <span class="badge badge-ai">MCP</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Core</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-core">TypeScript</span>
          <span class="badge badge-core">JavaScript</span>
          <span class="badge badge-core">Node.js</span>
          <span class="badge badge-core">Python</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Backend</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-backend">NestJS</span>
          <span class="badge badge-backend">FastAPI</span>
          <span class="badge badge-backend">Laravel</span>
          <span class="badge badge-backend">REST APIs</span>
          <span class="badge badge-backend">GraphQL</span>
          <span class="badge badge-backend">WebSockets</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Frontend</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-frontend">React</span>
          <span class="badge badge-frontend">Next.js</span>
          <span class="badge badge-frontend">Tailwind CSS</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Web3</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-web3">Solidity</span>
          <span class="badge badge-web3">ethers.js</span>
          <span class="badge badge-web3">viem</span>
          <span class="badge badge-web3">Smart Contracts</span>
          <span class="badge badge-web3">DeFi Protocols</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Infra</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-infra">Docker</span>
          <span class="badge badge-infra">Linux</span>
          <span class="badge badge-infra">Bash</span>
          <span class="badge badge-infra">CI/CD</span>
          <span class="badge badge-infra">Server Management</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Databases</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-db">PostgreSQL</span>
          <span class="badge badge-db">MariaDB</span>
          <span class="badge badge-db">SQLite</span>
          <span class="badge badge-db">Redis</span>
          <span class="badge badge-db">pgvector</span>
          <span class="badge badge-db">Qdrant</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-y-2 sm:gap-x-3 sm:gap-y-2">
        <span class="font-pixel-label text-[10px] uppercase text-[var(--fg-muted)] sm:w-24 sm:shrink-0">Emerging</span>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-emerging">AI Agents</span>
          <span class="badge badge-emerging">Evals</span>
          <span class="badge badge-emerging">Voice AI</span>
          <span class="badge badge-emerging">Blockchain Bots</span>
          <span class="badge badge-emerging">Trading Systems</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Áreas de Enfoque -->
  <section>
    <h2 class="text-xl font-semibold mb-4">
      <span x-show="language === 'es'">Áreas de Enfoque</span>
      <span x-show="language === 'en'">Focus Areas</span>
    </h2>
    <ul class="notion-list">
      <li x-show="language === 'es'">
        <strong>Agentes Autónomos &amp; Sistemas LLM</strong> — Orquestación multi-agente, tool-calling, pipelines RAG y evaluación continua en producción.
      </li>
      <li x-show="language === 'es'">
        <strong>Web3 &amp; Blockchain</strong> — Integración de wallets, protocolos DeFi y bots de trading automatizados.
      </li>
      <li x-show="language === 'es'">
        <strong>Arquitecturas Backend Escalables</strong> — Microservicios en TypeScript y Python, colas de eventos y APIs robustas.
      </li>
      <li x-show="language === 'es'">
        <strong>Infraestructura Linux &amp; Despliegues</strong> — Contenedores Docker, automatización en Bash y observabilidad en producción.
      </li>

      <li x-show="language === 'en'">
        <strong>Autonomous Agents &amp; LLM Systems</strong> — Multi-agent orchestration, tool-calling, RAG pipelines and continuous evaluation in production.
      </li>
      <li x-show="language === 'en'">
        <strong>Web3 &amp; Blockchain</strong> — Wallet integrations, DeFi protocols and automated trading bots.
      </li>
      <li x-show="language === 'en'">
        <strong>Scalable Backend Architectures</strong> — TypeScript and Python microservices, event queues and robust APIs.
      </li>
      <li x-show="language === 'en'">
        <strong>Linux Infrastructure &amp; Deploys</strong> — Docker containers, Bash automation and production observability.
      </li>
    </ul>
  </section>
</Layout>
