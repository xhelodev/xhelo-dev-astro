---
import Layout from "../layouts/Layout.astro";
import LofiPlayer from "../components/LofiPlayer.astro";
---

<Layout>
  <!-- Back to home -->
  <div class="pt-6 sm:pt-10">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-11"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      <span>volver</span>
    </a>
  </div>

  <LofiPlayer />

  <p class="text-[var(--fg-faint)] text-sm leading-relaxed">
    Cada semilla (seed) produce siempre la misma pista: compartila con el link.
    El archivo <code>.mid</code> exporta la composición (acordes, bajo, melodía,
    batería, swing y velocidades) lista para Ableton, Logic o FL Studio — no el
    audio con vinilo, que se sintetiza en vivo en tu navegador.
  </p>
</Layout>
