---
// LofiPlayer — sticky thin pixel music bar (Stitch design, "8-BIT RADIO").
// Vanilla island: markup here, state in the bundled <script>. Audio modules
// load lazily on first interaction.
---

<aside
  id="lofi-player"
  aria-label="Reproductor de música"
  class="sticky top-0 z-40 w-full border-b-2 border-[var(--border-strong)] bg-[var(--bg-soft)] relative"
>
  <div id="lofi-progress" class="lofi-progress" aria-hidden="true"></div>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-2 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <!-- Pixel equalizer -->
      <div id="lofi-eq" class="eq-bars flex items-end gap-[3px] h-4 shrink-0" aria-hidden="true">
        <span class="eq-bar"></span>
        <span class="eq-bar"></span>
        <span class="eq-bar"></span>
        <span class="eq-bar"></span>
      </div>
      <span
        class="font-pixel-label text-xs text-[var(--accent)] shrink-0 hidden sm:inline"
        title="Sintetizador Web Audio en tiempo real · lofi determinista por seed · cero archivos de audio"
      >8-BIT RADIO</span>
      <button
        id="lofi-track"
        type="button"
        title="Copiar link de esta pista"
        class="font-pixel-label text-xs text-[var(--fg)] truncate hover:text-[var(--accent)] transition-colors min-h-11 py-1"
      >—</button>
      <span id="lofi-time" class="text-xs text-[var(--fg-faint)] tabular-nums shrink-0 hidden md:inline">0:00 / 0:00</span>
    </div>

    <div class="flex items-center gap-1 shrink-0">
      <button id="lofi-prev" type="button" aria-label="Pista anterior" title="Pista anterior" class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-11 min-w-9 inline-flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
      </button>
      <button id="lofi-play" type="button" aria-label="Reproducir" title="Reproducir / pausar" class="text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors min-h-11 min-w-9 inline-flex items-center justify-center">
        <svg id="lofi-icon-play" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <svg id="lofi-icon-pause" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hidden"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
      </button>
      <button id="lofi-next" type="button" aria-label="Siguiente pista" title="Siguiente pista" class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-11 min-w-9 inline-flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 18l8.5-6L6 6v12zM16 6h2v12h-2z"/></svg>
      </button>
      <button id="lofi-mute" type="button" aria-label="Volumen" title="Volumen (click para subir)" class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-11 inline-flex items-center justify-center gap-[2px] px-1">
        <span class="flex items-end gap-[2px] h-3.5" aria-hidden="true">
          <span class="lofi-vol-block w-[3px] h-1.5 bg-[var(--fg-muted)]"></span>
          <span class="lofi-vol-block w-[3px] h-2.5 bg-[var(--fg-muted)]"></span>
          <span class="lofi-vol-block w-[3px] h-3 bg-[var(--fg-muted)]"></span>
          <span class="lofi-vol-block w-[3px] h-3.5 bg-[var(--fg-muted)]"></span>
          <span class="lofi-vol-block w-[3px] h-4 bg-[var(--fg-muted)]"></span>
        </span>
      </button>
      <button id="lofi-crackle" type="button" aria-pressed="true" title="Crackle de vinilo" aria-label="Crackle de vinilo" class="pixel-btn font-pixel-label text-xs px-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)] min-h-11">VIN</button>
      <button id="lofi-wobble" type="button" aria-pressed="true" title="Wobble de cinta" aria-label="Wobble de cinta" class="pixel-btn font-pixel-label text-xs px-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)] min-h-11">TAPE</button>
      <button id="lofi-export" type="button" title="Exporta la composición (notas, swing, velocidades), no el audio sintetizado" class="pixel-btn font-pixel-label text-xs px-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)] min-h-11" aria-label="Descargar .mid">.MID</button>
    </div>
  </div>
</aside>

<script>
  import { DEFAULT_FX, generateLofiTrack } from "../lib/lofi/generator";
  import type { FxSettings, LofiTrack } from "../lib/lofi/types";
  import type { LofiEngine } from "../lib/lofi/audio-engine";

  const SEED_WORDS = ["rainy", "midnight", "velvet", "dusty", "cafe", "tape", "amber", "navy", "neon", "paper"];

  function randomSeed(): string {
    const word = SEED_WORDS[Math.floor(Math.random() * SEED_WORDS.length)];
    const n = Math.floor(Math.random() * 1000);
    return `${word}-${n}`;
  }

  function requireEl<T extends HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`missing element #${id}`);
    return el as T;
  }

  const els = {
    eq: requireEl<HTMLElement>("lofi-eq"),
    progress: requireEl<HTMLElement>("lofi-progress"),
    track: requireEl<HTMLButtonElement>("lofi-track"),
    time: requireEl<HTMLElement>("lofi-time"),
    play: requireEl<HTMLButtonElement>("lofi-play"),
    prev: requireEl<HTMLButtonElement>("lofi-prev"),
    next: requireEl<HTMLButtonElement>("lofi-next"),
    mute: requireEl<HTMLButtonElement>("lofi-mute"),
    volBlocks: Array.from(document.querySelectorAll<HTMLElement>(".lofi-vol-block")),
    crackle: requireEl<HTMLButtonElement>("lofi-crackle"),
    wobble: requireEl<HTMLButtonElement>("lofi-wobble"),
    exportBtn: requireEl<HTMLButtonElement>("lofi-export"),
    iconPlay: requireEl<HTMLElement>("lofi-icon-play"),
    iconPause: requireEl<HTMLElement>("lofi-icon-pause"),
  };

  // Stepped pixel volume: 5 levels, persisted (agy review).
  const VOLUME_LEVELS = [0, 0.25, 0.5, 0.75, 1];
  const storedVolume = Number(window.localStorage.getItem("lofi-volume"));
  let volumeIndex = VOLUME_LEVELS.includes(storedVolume)
    ? VOLUME_LEVELS.indexOf(storedVolume)
    : VOLUME_LEVELS.indexOf(DEFAULT_FX.volume) >= 0
      ? VOLUME_LEVELS.indexOf(DEFAULT_FX.volume)
      : 3;

  let ctx: AudioContext | null = null;
  let engine: LofiEngine | null = null;
  let fx: FxSettings = { ...DEFAULT_FX, volume: VOLUME_LEVELS[volumeIndex] };
  let playing = false;

  // Seed history for prev/next navigation.
  const initialSeed = new URLSearchParams(window.location.search).get("seed");
  const historySeeds: string[] = [initialSeed && initialSeed.trim().length > 0 ? initialSeed.trim() : randomSeed()];
  let historyIndex = 0;
  let track: LofiTrack = generateLofiTrack(historySeeds[0]);

  // Elapsed-time tracking (display only).
  let elapsedMs = 0;
  let startedAt = 0;
  let timeTimer: ReturnType<typeof setInterval> | null = null;

  function trackName(): string {
    return `${track.seed.toUpperCase()}.MOD`;
  }

  function loopSeconds(): number {
    return (track.bars * 4 * 60) / track.bpm;
  }

  function fmt(seconds: number): string {
    const s = Math.max(0, Math.floor(seconds));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  function renderTrackInfo(): void {
    els.track.textContent = `${trackName()} · ${track.bpm}BPM · ${track.key}`;
  }

  function renderTime(): void {
    const total = loopSeconds();
    const current = playing ? (elapsedMs + (performance.now() - startedAt)) / 1000 : elapsedMs / 1000;
    const looped = current % total;
    els.time.textContent = `${fmt(looped)} / ${fmt(total)}`;
    els.progress.style.width = `${Math.min(100, (looped / total) * 100)}%`;
  }

  function syncSeedUrl(): void {
    const url = new URL(window.location.href);
    url.searchParams.set("seed", track.seed);
    window.history.replaceState(null, "", url);
  }

  function updatePlayingUI(): void {
    els.iconPlay.classList.toggle("hidden", playing);
    els.iconPause.classList.toggle("hidden", !playing);
    els.play.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
    els.eq.classList.toggle("eq-playing", playing);
    if (playing) {
      startedAt = performance.now();
      if (timeTimer === null) timeTimer = setInterval(renderTime, 500);
    } else {
      if (timeTimer !== null) {
        clearInterval(timeTimer);
        timeTimer = null;
      }
      renderTime();
    }
  }

  function updateFxUI(): void {
    els.crackle.setAttribute("aria-pressed", String(fx.crackle));
    els.crackle.style.color = fx.crackle ? "var(--accent)" : "";
    els.wobble.setAttribute("aria-pressed", String(fx.wobble));
    els.wobble.style.color = fx.wobble ? "var(--accent)" : "";
    const level = fx.volume;
    els.volBlocks.forEach((block, i) => {
      block.style.background = i < Math.round(level * 5) ? "var(--accent)" : "var(--border)";
    });
    els.mute.setAttribute("aria-label", `Volumen: ${Math.round(level * 100)}%`);
    els.mute.title = `Volumen: ${Math.round(level * 100)}% (click para cambiar)`;
  }

  function loadSeed(seed: string): void {
    track = generateLofiTrack(seed);
    elapsedMs = 0;
    renderTrackInfo();
    renderTime();
    syncSeedUrl();
    engine?.setTrack(track);
  }

  els.play.addEventListener("click", () => {
    void (async () => {
      // iOS Safari: create and resume the AudioContext SYNCHRONOUSLY inside
      // the gesture handler, BEFORE any await import(...).
      if (!ctx) {
        const Ctor =
          window.AudioContext ??
          (window as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctor) return;
        ctx = new Ctor();
      }
      if (ctx.state === "suspended") void ctx.resume();

      if (!engine) {
        const { createLofiEngine } = await import("../lib/lofi/audio-engine");
        engine = createLofiEngine(ctx, track, fx);
        engine.onStateChange = (isPlaying) => {
          if (!isPlaying && playing) elapsedMs += performance.now() - startedAt;
          playing = isPlaying;
          updatePlayingUI();
        };
      }
      if (playing) {
        engine.pause();
      } else {
        engine.play();
      }
    })();
  });

  els.prev.addEventListener("click", () => {
    if (historyIndex > 0) {
      historyIndex -= 1;
      loadSeed(historySeeds[historyIndex]);
    }
  });

  els.next.addEventListener("click", () => {
    if (historyIndex < historySeeds.length - 1) {
      historyIndex += 1;
    } else {
      historySeeds.push(randomSeed());
      historyIndex = historySeeds.length - 1;
    }
    loadSeed(historySeeds[historyIndex]);
  });

  els.track.addEventListener("click", () => {
    void navigator.clipboard?.writeText(window.location.href).then(() => {
      const name = els.track.textContent;
      els.track.textContent = "LINK COPIADO";
      window.setTimeout(() => renderTrackInfo(), 1200);
      void name;
    });
  });

  els.mute.addEventListener("click", () => {
    volumeIndex = (volumeIndex + 1) % VOLUME_LEVELS.length;
    fx = { ...fx, volume: VOLUME_LEVELS[volumeIndex] };
    window.localStorage.setItem("lofi-volume", String(fx.volume));
    updateFxUI();
    engine?.setFx(fx);
  });

  els.crackle.addEventListener("click", () => {
    fx = { ...fx, crackle: !fx.crackle };
    updateFxUI();
    engine?.setFx(fx);
  });

  els.wobble.addEventListener("click", () => {
    fx = { ...fx, wobble: !fx.wobble };
    updateFxUI();
    engine?.setFx(fx);
  });

  els.exportBtn.addEventListener("click", () => {
    void (async () => {
      const { downloadMidi } = await import("../lib/lofi/midi-export");
      downloadMidi(track);
    })();
  });

  // ClientRouter (View Transitions): stop cleanly on navigation.
  document.addEventListener("astro:before-swap", () => {
    engine?.stop();
  });

  renderTrackInfo();
  updateFxUI();
  updatePlayingUI();
  if (!initialSeed || initialSeed.trim().length === 0) {
    syncSeedUrl();
  }
</script>
