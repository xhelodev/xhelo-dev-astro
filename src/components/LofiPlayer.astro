---
// LofiPlayer — sticky thin pixel music bar (Stitch design, "8-BIT RADIO").
// Vanilla island: markup here, state in the bundled <script>. Audio modules
// load lazily on first interaction.
---

<aside
  id="lofi-player"
  aria-label="Reproductor de música"
  class="sticky top-0 z-40 w-full border-b-2 border-[var(--border-strong)] bg-[var(--bg-soft)] relative"
>
  <div id="lofi-progress" class="lofi-progress" aria-hidden="true"></div>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-2 flex flex-col gap-1.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <!-- Pixel equalizer -->
        <div id="lofi-eq" class="eq-bars flex items-end gap-[3px] h-4 shrink-0" aria-hidden="true">
          <span class="eq-bar"></span>
          <span class="eq-bar"></span>
          <span class="eq-bar"></span>
          <span class="eq-bar"></span>
        </div>
        <span
          class="font-pixel-label text-xs text-[var(--accent)] shrink-0 hidden sm:inline"
          title="Sintetizador 16-bit Web Audio en tiempo real · MIDI generado por IA · cero archivos de audio"
        >16-BIT RADIO</span>
        <button
          id="lofi-track"
          type="button"
          title="Copiar link de esta pista"
          class="font-pixel-label text-xs text-[var(--fg)] truncate hover:text-[var(--accent)] transition-colors min-h-9 py-1"
        >—</button>
        <span id="lofi-time" class="text-xs text-[var(--fg-faint)] tabular-nums shrink-0 hidden md:inline">0:00 / 0:00</span>
      </div>

      <div class="flex items-center gap-1 shrink-0">
        <button id="lofi-prev" type="button" aria-label="Pista anterior" title="Pista anterior" disabled class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-9 min-w-8 inline-flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
        </button>
        <button id="lofi-play" type="button" aria-label="Reproducir" title="Reproducir / pausar" disabled class="text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors min-h-9 min-w-8 inline-flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
          <svg id="lofi-icon-play" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <svg id="lofi-icon-pause" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hidden"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
        </button>
        <button id="lofi-next" type="button" aria-label="Siguiente pista" title="Siguiente pista" disabled class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-9 min-w-8 inline-flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 18l8.5-6L6 6v12zM16 6h2v12h-2z"/></svg>
        </button>
        <button id="lofi-mute" type="button" aria-label="Volumen" title="Volumen (click para subir)" class="text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors min-h-9 inline-flex items-center justify-center gap-[2px] px-1">
          <span class="flex items-end gap-[2px] h-3.5" aria-hidden="true">
            <span class="lofi-vol-block w-[3px] h-1.5 bg-[var(--fg-muted)]"></span>
            <span class="lofi-vol-block w-[3px] h-2.5 bg-[var(--fg-muted)]"></span>
            <span class="lofi-vol-block w-[3px] h-3 bg-[var(--fg-muted)]"></span>
            <span class="lofi-vol-block w-[3px] h-3.5 bg-[var(--fg-muted)]"></span>
            <span class="lofi-vol-block w-[3px] h-4 bg-[var(--fg-muted)]"></span>
          </span>
        </button>
        <button id="lofi-export" type="button" title="Exporta la composición (notas, swing, velocidades), no el audio sintetizado" disabled class="pixel-btn font-pixel-label text-xs px-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)] min-h-8 disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Descargar .mid">.MID</button>
      </div>
    </div>

    <form id="lofi-prompt-form" class="flex items-center gap-2" autocomplete="off">
      <label for="lofi-prompt" class="sr-only">Estilo musical</label>
      <input
        id="lofi-prompt"
        name="prompt"
        type="text"
        maxlength="140"
        placeholder="Estilo (ej: snes rpg, genesis fm, bossa lluviosa, synthwave)..."
        class="flex-1 min-w-0 bg-[var(--bg)] border border-[var(--border-strong)] px-2.5 py-1 text-xs text-[var(--fg)] placeholder:text-[var(--fg-faint)] focus:border-[var(--accent)] focus:outline-none"
      />
      <button
        id="lofi-generate"
        type="submit"
        class="pixel-btn font-pixel-label text-xs px-2.5 py-1 text-[var(--accent)] hover:text-[var(--accent-hover)] shrink-0 disabled:opacity-50"
      >GEN</button>
      <span id="lofi-status" role="status" aria-live="polite" class="font-pixel-label text-[10px] text-[var(--fg-faint)] shrink-0 hidden"></span>
    </form>
  </div>
</aside>

<script>
  import { DEFAULT_FX } from "../lib/lofi/generator";
  import type { FxSettings, LofiTrack } from "../lib/lofi/types";
  import type { LofiEngine } from "../lib/lofi/audio-engine";

  function requireEl<T extends HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`missing element #${id}`);
    return el as T;
  }

  const els = {
    eq: requireEl<HTMLElement>("lofi-eq"),
    progress: requireEl<HTMLElement>("lofi-progress"),
    track: requireEl<HTMLButtonElement>("lofi-track"),
    time: requireEl<HTMLElement>("lofi-time"),
    play: requireEl<HTMLButtonElement>("lofi-play"),
    prev: requireEl<HTMLButtonElement>("lofi-prev"),
    next: requireEl<HTMLButtonElement>("lofi-next"),
    mute: requireEl<HTMLButtonElement>("lofi-mute"),
    volBlocks: Array.from(document.querySelectorAll<HTMLElement>(".lofi-vol-block")),
    exportBtn: requireEl<HTMLButtonElement>("lofi-export"),
    iconPlay: requireEl<HTMLElement>("lofi-icon-play"),
    iconPause: requireEl<HTMLElement>("lofi-icon-pause"),
    promptForm: requireEl<HTMLFormElement>("lofi-prompt-form"),
    promptInput: requireEl<HTMLInputElement>("lofi-prompt"),
    generateBtn: requireEl<HTMLButtonElement>("lofi-generate"),
    status: requireEl<HTMLElement>("lofi-status"),
  };

  interface HistoryEntry {
    track: LofiTrack;
    shareableSeed: string | null;
  }

  // Stepped pixel volume: 5 levels, persisted (agy review).
  const VOLUME_LEVELS = [0, 0.25, 0.5, 0.75, 1];
  const storedVolume = Number(window.localStorage.getItem("lofi-volume"));
  let volumeIndex = VOLUME_LEVELS.includes(storedVolume)
    ? VOLUME_LEVELS.indexOf(storedVolume)
    : VOLUME_LEVELS.indexOf(DEFAULT_FX.volume) >= 0
      ? VOLUME_LEVELS.indexOf(DEFAULT_FX.volume)
      : 3;

  let ctx: AudioContext | null = null;
  let engine: LofiEngine | null = null;
  let fx: FxSettings = { ...DEFAULT_FX, volume: VOLUME_LEVELS[volumeIndex] };
  let playing = false;
  let generating = false;

  // Track history for prev/next navigation (AI tracks only — L28: the bar
  // starts idle; nothing exists until the first GEN).
  const historyEntries: HistoryEntry[] = [];
  let historyIndex = -1;
  let track: LofiTrack | null = null;

  // Elapsed-time tracking (display only).
  let elapsedMs = 0;
  let startedAt = 0;
  let timeTimer: ReturnType<typeof setInterval> | null = null;

  function trackName(): string {
    return track ? `${track.seed.toUpperCase()}.MOD` : "PROMPT.MOD";
  }

  function loopSeconds(): number {
    return track ? (track.bars * 4 * 60) / track.bpm : 0;
  }

  function fmt(seconds: number): string {
    const s = Math.max(0, Math.floor(seconds));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  function renderTrackInfo(): void {
    els.track.textContent = track
      ? `${trackName()} · ${track.bpm}BPM · ${track.key}`
      : "PROMPT.MOD · ENVIÁ UN ESTILO";
  }

  function renderTime(): void {
    if (!track) {
      els.time.textContent = "0:00 / 0:00";
      els.progress.style.width = "0%";
      return;
    }
    const total = loopSeconds();
    const current = playing ? (elapsedMs + (performance.now() - startedAt)) / 1000 : elapsedMs / 1000;
    const looped = current % total;
    els.time.textContent = `${fmt(looped)} / ${fmt(total)}`;
    els.progress.style.width = `${Math.min(100, (looped / total) * 100)}%`;
  }

  function syncSeedUrl(seed: string | null): void {
    const url = new URL(window.location.href);
    if (seed) {
      url.searchParams.set("seed", seed);
    } else {
      url.searchParams.delete("seed");
    }
    window.history.replaceState(null, "", url);
  }

  function setStatus(message: string, isError = false): void {
    if (!message) {
      els.status.textContent = "";
      els.status.classList.add("hidden");
      return;
    }
    els.status.textContent = message;
    els.status.style.color = isError ? "var(--tertiary)" : "var(--accent)";
    els.status.classList.remove("hidden");
  }

  function updatePlayingUI(): void {
    els.iconPlay.classList.toggle("hidden", playing);
    els.iconPause.classList.toggle("hidden", !playing);
    els.play.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
    els.eq.classList.toggle("eq-playing", playing);
    if (playing) {
      startedAt = performance.now();
      if (timeTimer === null) timeTimer = setInterval(renderTime, 500);
    } else {
      if (timeTimer !== null) {
        clearInterval(timeTimer);
        timeTimer = null;
      }
      renderTime();
    }
  }

  function updateFxUI(): void {
    const level = fx.volume;
    els.volBlocks.forEach((block, i) => {
      block.style.background = i < Math.round(level * 5) ? "var(--accent)" : "var(--border)";
    });
    els.mute.setAttribute("aria-label", `Volumen: ${Math.round(level * 100)}%`);
    els.mute.title = `Volumen: ${Math.round(level * 100)}% (click para cambiar)`;
  }

  function unlockAudioContext(): AudioContext | null {
    // iOS Safari: create and resume the AudioContext SYNCHRONOUSLY inside
    // the gesture handler, BEFORE any await import(...) or fetch(...).
    if (!ctx) {
      const Ctor =
        window.AudioContext ??
        (window as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!Ctor) return null;
      ctx = new Ctor();
    }
    if (ctx.state === "suspended") void ctx.resume();
    return ctx;
  }

  async function ensureEngine(): Promise<LofiEngine | null> {
    if (!ctx || !track) return null;
    if (!engine) {
      const { createLofiEngine } = await import("../lib/lofi/audio-engine");
      engine = createLofiEngine(ctx, track, fx);
      engine.onStateChange = (isPlaying) => {
        if (!isPlaying && playing) elapsedMs += performance.now() - startedAt;
        playing = isPlaying;
        updatePlayingUI();
      };
    }
    return engine;
  }

  function loadEntry(entry: HistoryEntry): void {
    track = entry.track;
    elapsedMs = 0;
    renderTrackInfo();
    renderTime();
    syncSeedUrl(entry.shareableSeed);
    engine?.setTrack(track);
    updateNavUI();
  }

  /** Transport availability follows the history: nothing is playable or
   *  exportable until the first GEN (L28). */
  function updateNavUI(): void {
    const hasTrack = track !== null;
    els.play.disabled = !hasTrack;
    els.exportBtn.disabled = !hasTrack;
    els.prev.disabled = !hasTrack || historyIndex <= 0;
    els.next.disabled = !hasTrack || historyIndex >= historyEntries.length - 1;
  }

  els.play.addEventListener("click", () => {
    if (!track) return;
    void (async () => {
      if (!unlockAudioContext()) return;
      const eng = await ensureEngine();
      if (!eng) return;
      if (playing) {
        eng.pause();
      } else {
        eng.play();
      }
    })();
  });

  els.prev.addEventListener("click", () => {
    if (historyIndex > 0) {
      historyIndex -= 1;
      loadEntry(historyEntries[historyIndex]);
    }
  });

  els.next.addEventListener("click", () => {
    // Navigation only (L28): no seed generation — the AI prompt is the sole
    // way new tracks enter the history.
    if (historyIndex < historyEntries.length - 1) {
      historyIndex += 1;
      loadEntry(historyEntries[historyIndex]);
    }
  });

  els.promptForm.addEventListener("submit", (event) => {
    event.preventDefault();
    if (generating) return;

    const prompt = els.promptInput.value.trim();
    if (prompt.length < 2) {
      setStatus("ESCRIBÍ UN ESTILO", true);
      els.promptInput.focus();
      return;
    }

    // Unlock audio synchronously while still inside the user submit gesture.
    unlockAudioContext();

    void (async () => {
      generating = true;
      els.promptInput.disabled = true;
      els.generateBtn.disabled = true;
      els.generateBtn.textContent = "...";
      setStatus("GENERANDO...");

      try {
        const res = await fetch("/api/lofi", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt }),
        });
        const payload = (await res.json().catch(() => ({}))) as { track?: LofiTrack; error?: string };
        if (!res.ok || !payload.track) {
          setStatus(payload.error ? "ERROR AL GENERAR" : "SIN RESPUESTA", true);
          return;
        }

        const entry: HistoryEntry = { track: payload.track, shareableSeed: null };
        historyEntries.splice(historyIndex + 1);
        historyEntries.push(entry);
        historyIndex = historyEntries.length - 1;
        loadEntry(entry);

        const eng = await ensureEngine();
        if (eng && !playing) {
          eng.play();
        }
        setStatus("LISTO");
        window.setTimeout(() => {
          if (!generating) setStatus("");
        }, 1800);
      } catch {
        setStatus("ERROR DE RED", true);
      } finally {
        generating = false;
        els.promptInput.disabled = false;
        els.generateBtn.disabled = false;
        els.generateBtn.textContent = "GEN";
      }
    })();
  });

  els.track.addEventListener("click", () => {
    void navigator.clipboard?.writeText(window.location.href).then(() => {
      els.track.textContent = "LINK COPIADO";
      window.setTimeout(() => renderTrackInfo(), 1200);
    });
  });

  els.mute.addEventListener("click", () => {
    volumeIndex = (volumeIndex + 1) % VOLUME_LEVELS.length;
    fx = { ...fx, volume: VOLUME_LEVELS[volumeIndex] };
    window.localStorage.setItem("lofi-volume", String(fx.volume));
    updateFxUI();
    engine?.setFx(fx);
  });

  els.exportBtn.addEventListener("click", () => {
    void (async () => {
      if (!track) return;
      const { downloadMidi } = await import("../lib/lofi/midi-export");
      downloadMidi(track);
    })();
  });

  // ClientRouter (View Transitions): stop cleanly on navigation.
  document.addEventListener("astro:before-swap", () => {
    engine?.stop();
  });

  renderTrackInfo();
  updateFxUI();
  updatePlayingUI();
  updateNavUI();
  // `?seed=` share links are dead (S4/L28): strip any stale one on load.
  syncSeedUrl(null);
</script>
